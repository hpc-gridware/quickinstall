# Copyright (C) 2024-2026 Gridware GmbH
# Multi-node Open Cluster Scheduler Docker Container for Rocky Linux 9

# The floating tag 9 always resolves to the latest 9.x patch release;
# rebuild with --pull to pick up a new one.
FROM rockylinux/rockylinux:9

LABEL maintainer="HPC Gridware GmbH"
LABEL description="Open Cluster Scheduler Multi-node on Rocky Linux 9"

# Install basic dependencies required by the installation script and OCS
# runtime. curl is left out on purpose: the base image ships curl-minimal,
# which is enough here and conflicts with the full curl package. Unlike the
# openSUSE openssh package, EL9 splits the ssh server and clients.
# procps-ng is required: unlike the openSUSE base image, the Rocky base
# image has no ps/pgrep, the OCS installer (util/arch_variables, inst_sge)
# fails without ps and the startup scripts check daemons with pgrep.
RUN dnf install -y \
    sudo \
    ca-certificates \
    gzip \
    tar \
    hostname \
    which \
    procps-ng \
    iproute \
    iputils \
    binutils \
    vim-enhanced \
    openssh-server \
    openssh-clients \
    man-db \
    && dnf clean all

# Create gridware user for shared operations across all nodes.
# 'usermod -p *' unlocks the account for pubkey SSH logins without
# setting a password (useradd leaves it locked with '!').
RUN useradd -m -u 1000 -s /bin/bash gridware && \
    usermod -p '*' gridware && \
    echo "gridware ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Host keys are regenerated whenever a container is recreated, so strict
# host key checking would break cluster-internal SSH after every restart.
RUN printf 'Host *\n    StrictHostKeyChecking no\n    UserKnownHostsFile /dev/null\n    LogLevel ERROR\n' >> /etc/ssh/ssh_config

# Wire up the OCS shell environment at image build time so it is present even
# when the installation later fails. /etc/profile.d covers login and ssh
# shells; the .bashrc lines cover the interactive non-login shell of
# "docker exec -it bash". The settings.sh path in the comment line is the
# marker ocs.sh greps for, which keeps the installer from appending a second,
# unguarded sourcing line.
COPY ocs-env.sh /etc/profile.d/ocs.sh
COPY ocs-banner.sh /etc/ocs-banner.sh
RUN chmod 644 /etc/profile.d/ocs.sh /etc/ocs-banner.sh && \
    printf '%s\n' \
      '# Open Cluster Scheduler environment: /opt/ocs/default/common/settings.sh' \
      '. /etc/profile.d/ocs.sh' > /etc/ocs-bashrc.snippet && \
    cat /etc/ocs-bashrc.snippet >> /root/.bashrc && \
    cat /etc/ocs-bashrc.snippet >> /home/gridware/.bashrc && \
    chown gridware:gridware /home/gridware/.bashrc

# Copy startup scripts
COPY startup-master.sh /startup-master.sh
COPY startup-worker.sh /startup-worker.sh
RUN chmod +x /startup-master.sh /startup-worker.sh

# Create entrypoint script that selects master or worker startup
RUN echo '#!/bin/bash' > /entrypoint.sh && \
    echo 'if [ "$OCS_NODE_TYPE" = "master" ]; then' >> /entrypoint.sh && \
    echo '    exec /startup-master.sh "$@"' >> /entrypoint.sh && \
    echo 'else' >> /entrypoint.sh && \
    echo '    exec /startup-worker.sh "$@"' >> /entrypoint.sh && \
    echo 'fi' >> /entrypoint.sh && \
    chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash", "-c", "while true; do sleep 3600; done"]
